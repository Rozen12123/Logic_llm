fact1
	foreach
		facts.Cold($x, True)
	assert
		facts.Sees($x, Rabbit, True)

fact2
	foreach
		facts.Sees($x, Tiger, True)
		facts.Kind(Tiger, True)
	assert
		facts.Sees($x, BaldEagle, True)

fact3
	foreach
		facts.Red(Rabbit, True)
		facts.Rough(Rabbit, True)
	assert
		facts.Likes(Rabbit, Bear, True)

fact4
	foreach
		facts.Sees($x, Rabbit, True)
	assert
		facts.Eats(Rabbit, BaldEagle, True)

fact5
	foreach
		facts.Eats($x, BaldEagle, True)
	assert
		facts.Cold($x, True)

fact6
	foreach
		facts.Sees($x, BaldEagle, True)
		facts.Eats($x, Bear, True)
	assert
		facts.Likes($x, BaldEagle, True)